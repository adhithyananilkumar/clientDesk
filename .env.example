# ClientDesk environment (public client configuration only).
# Copy to .env.local and fill in. Values come from
# Supabase Dashboard -> Project Settings -> API Keys / Data API.
# Restart Metro after any change:  npx expo start -c

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (starts with sb_publishable_). Safe in the app because Row Level
# Security protects the data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NEVER put the secret / service_role key or the database password in this app.
# Anything prefixed EXPO_PUBLIC_ is bundled into the client and readable by users.
